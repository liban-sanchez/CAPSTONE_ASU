{
  "name": "Project Scraper by Grey-box",
  "description": "A Chrome extension which downloads a website",
  "version": "3.3.0",
  "manifest_version": 3,
  "icons": {
    "128": "images/icons/grey-box_128.png",
    "48": "images/icons/grey-box_48.png",
    "16": "images/icons/grey-box_16.png"
  },

  "permissions": [
  "storage",
  "tabs",
  "downloads",
  "scripting",
  "activeTab",
  "contextMenus"
],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "js/background.js"
  },

  "action": {
    "default_popup": "html/popup.html"
  }
}
